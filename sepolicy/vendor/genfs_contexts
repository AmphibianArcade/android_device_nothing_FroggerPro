# Battery
genfscon proc /touchpanel/TP_charger_flags   u:object_r:vendor_proc_power_supply:s0
genfscon sysfs /class/power_supply/battery u:object_r:vendor_sysfs_battery_supply:s0
genfscon sysfs /class/qcom-battery u:object_r:vendor_sysfs_battery_supply:s0

# Charger 
genfscon sysfs /class/qcom-battery/usb_real_type u:object_r:vendor_sysfs_battery_supply:s0
genfscon proc /charger   u:object_r:vendor_proc_power_supply:s0
genfscon proc /charger/usb_charger_en u:object_r:vendor_proc_power_supply:s0

# Fingerprint
genfscon proc /touchpanel/fod_mode         u:object_r:vendor_proc_fingerprint:s0
genfscon sysfs /panel_feature/fp_status    u:object_r:vendor_sysfs_fingerprint:s0

# Scheduler (Walt)
genfscon proc /sys/walt u:object_r:proc_sched_walt:s0

# Touch
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_gesture_single_tap_enabled    u:object_r:vendor_sysfs_touch:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_gesture_single_tap_pressed    u:object_r:vendor_sysfs_touch:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_fod_enabled   u:object_r:vendor_sysfs_touch:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_fod_pressed    u:object_r:vendor_sysfs_touch:s0

# Vibrator 
genfscon sysfs /devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a88000.i2c/i2c-2/2-005f/leds/vibrator_nt u:object_r:sysfs_vibrator:s0

# Wakeup
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/wakeup       u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/soc:goodix_fp/wakeup   u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/soc:qcom,dsi-display-primary/wakeup     u:object_r:sysfs_wakeup:s0


