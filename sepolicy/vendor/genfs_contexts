# Battery
genfscon sysfs /class/qcom-battery u:object_r:vendor_sysfs_battery_supply:s0

# Fingerprint
genfscon proc /touchpanel/fod_mode         u:object_r:vendor_proc_fingerprint:s0
genfscon sysfs /panel_feature/fp_status    u:object_r:vendor_sysfs_fingerprint:s0

# Touch
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_gesture_single_tap_enabled    u:object_r:vendor_sysfs_touch:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_gesture_single_tap_pressed    u:object_r:vendor_sysfs_touch:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_fod_enabled   u:object_r:vendor_sysfs_touch:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.spi/spi_master/spi8/spi8.0/fts_fod_pressed    u:object_r:vendor_sysfs_touch:s0

